0:["3gah5ImHq9BuNIvFhVqXa",[[["",{"children":["product",{"children":[["slug","magvault-magnetic-wireless-powerbank-10000mah","d"],{"children":["__PAGE__?{\"slug\":\"magvault-magnetic-wireless-powerbank-10000mah\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["product",{"children":[["slug","magvault-magnetic-wireless-powerbank-10000mah","d"],{"children":["__PAGE__",{},[["$L1",["$","$L2",null,{"product":{"id":"prod-03","slug":"magvault-magnetic-wireless-powerbank-10000mah","name":"MagVault 10,000mAh Magnetic Wireless Fast Power Bank","category":"Smart Gadgets","price":3950,"originalPrice":5200,"discountPercent":24,"rating":4.7,"reviewCount":29,"images":["https://images.unsplash.com/photo-1609592424368-2a8dcf8c0dd1?auto=format&fit=crop&w=900&q=80","https://images.unsplash.com/photo-1585338107529-13afc5f02586?auto=format&fit=crop&w=900&q=80"],"thumbnail":"https://images.unsplash.com/photo-1609592424368-2a8dcf8c0dd1?auto=format&fit=crop&w=600&q=80","shortDescription":"Snap-on strong magnetic wireless charging with 20W PD Type-C bidirectional fast charge and digital LED percentage display.","description":"Never worry about low battery during power cuts or busy travel days in Pakistan. MagVault snaps firmly to magnetic cases or phones with up to 15W wireless charging and features an ultra-fast 20W Power Delivery USB-C port.","features":["Strong N52 Rare-Earth Magnets for Slip-Free Grip","20W USB-C Two-Way Fast Charging (0 to 60% in 35 mins)","Smart LED Digital Power Indicator Display","Foldable Desktop Kickstand for Hands-Free Video Viewing","Certified Multi-Protection Chipset (Overheating & Surge Proof)"],"specifications":{"Capacity":"10,000mAh (37Wh High-Density Li-Polymer)","Wireless Output":"15W Max (Backward compatible 10W / 7.5W / 5W)","Wired Output":"Type-C PD 20W (5V/3A, 9V/2.22A, 12V/1.67A)","Weight":"198g slim pocket design","In Box":"MagVault Power Bank, USB-C to USB-C 60W Cable, Manual"},"isNewArrival":true,"stockStatus":"in_stock","sku":"AMX-GAD-003","tag":"New"},"relatedProducts":[{"id":"prod-01","slug":"pulse-pro-anc-wireless-earbuds","name":"PulsePro Active Noise Cancelling Wireless Earbuds","category":"Smart Gadgets","price":4850,"originalPrice":6500,"discountPercent":25,"rating":4.8,"reviewCount":38,"images":["https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=900&q=80","https://images.unsplash.com/photo-1606220588913-b3aacb4d2f46?auto=format&fit=crop&w=900&q=80","https://images.unsplash.com/photo-1572536147248-ac59a8abfa4b?auto=format&fit=crop&w=900&q=80"],"thumbnail":"https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=600&q=80","shortDescription":"Hybrid active noise cancellation with 32-hour extended playback, deep bass acoustic drivers, and crystal-clear dual quad mics.","description":"Designed for daily commuters and audio enthusiasts across Pakistan. The PulsePro earbuds deliver immersive sound with advanced hybrid noise isolation, suppressing ambient street and traffic noise by up to 35dB. Featuring rapid USB-C fast charging, Bluetooth 5.3 instant pairing, and IPX5 sweat resistance.","features":["35dB Hybrid Active Noise Cancellation with Transparency Mode","32-Hour Battery Life with Compact Charging Case","Dual Quad Environmental Noise Cancellation Mics for Clear Calls","IPX5 Splash & Sweat Resistance for Workouts and Monsoon Weather","Ultra-Low Latency Gaming & Video Sync Mode"],"specifications":{"Bluetooth Version":"5.3 BLE","Battery Runtime":"8 hours (earbuds) + 24 hours (case)","Charging Interface":"USB Type-C Fast Charge","Driver Diameter":"11mm Titanium Composite Dynamic Drivers","Package Contents":"PulsePro Earbuds, Charging Case, 3 Pairs Silicone Tips (S/M/L), USB-C Cable, Manual"},"isTrending":true,"isBestSeller":true,"isFeatured":true,"stockStatus":"in_stock","sku":"AMX-GAD-001","tag":"Best Seller"},{"id":"prod-02","slug":"apex-ultra-smartwatch-titanium","name":"Apex Ultra Smartwatch 2.0 with AMOLED Display","category":"Smart Gadgets","price":7450,"originalPrice":9900,"discountPercent":25,"rating":4.9,"reviewCount":52,"images":["https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&fit=crop&w=900&q=80","https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=900&q=80","https://images.unsplash.com/photo-1579586337278-3befd40fd17a?auto=format&fit=crop&w=900&q=80"],"thumbnail":"https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&fit=crop&w=600&q=80","shortDescription":"1.96\" High-Definition AMOLED display, Bluetooth calling speaker, 100+ sports tracking modes, and 10-day standby battery.","description":"The Apex Ultra combines aerospace-grade alloy casing with brilliant AMOLED sharpness. Answer calls on the go, monitor your heart rate, blood oxygen (SpO2), sleep quality, and track your daily step goals. Fully compatible with Android and iOS devices.","features":["1.96-inch Always-on AMOLED Display (410x502 resolution)","Integrated Speaker & HD Mic for Direct Bluetooth Phone Calls","Real-time Heart Rate, Blood Oxygen (SpO2), & Sleep Analytics","100+ Indoor and Outdoor Sports Profiles","IP68 Certified Water & Dust Resistant"],"specifications":{"Compatibility":"Android 6.0+ & iOS 11.0+","Battery Capacity":"380 mAh (up to 7-10 days standard usage)","Display":"1.96\" AMOLED with curved scratch-resistant glass","Strap Material":"Comfort Fluoroelastomer Band + Additional Sport Loop","Sensors":"Optical PPG Sensor, 3-Axis Accelerometer"},"isTrending":true,"isFeatured":true,"stockStatus":"in_stock","sku":"AMX-GAD-002","tag":"Trending"}]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","product","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"paralle