0:["3gah5ImHq9BuNIvFhVqXa",[[["",{"children":["product",{"children":[["slug","thermal-glide-ceramic-straightening-brush","d"],{"children":["__PAGE__?{\"slug\":\"thermal-glide-ceramic-straightening-brush\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["product",{"children":[["slug","thermal-glide-ceramic-straightening-brush","d"],{"children":["__PAGE__",{},[["$L1",["$","$L2",null,{"product":{"id":"prod-11","slug":"thermal-glide-ceramic-straightening-brush","name":"ThermalGlide Ionic Ceramic Hair Straightening Heat Brush","category":"Beauty & Care","price":3650,"originalPrice":4900,"discountPercent":25,"rating":4.7,"reviewCount":37,"images":["https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=900&q=80","https://images.unsplash.com/photo-1527799820374-dcf8d9d4a388?auto=format&fit=crop&w=900&q=80"],"thumbnail":"https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=600&q=80","shortDescription":"PTC rapid heating in 30 seconds, anti-scald 3D comb teeth, negative ion generator to tame frizz and add mirror shine.","description":"Straighten your hair simply by brushing. Designed for busy mornings in Pakistan, ThermalGlide combines smooth ceramic heating elements with millions of negative ions to eliminate flyaways and seal hair cuticles.","features":["PTC Rapid Heat-Up in just 30 seconds","Anti-Scald Ceramic Comb Teeth with Cold Tips to prevent burning scalp","5 Temperature Presets (130°C to 200°C) for all hair textures","360° Swivel Power Cord prevents tangling","60-Minute Automatic Safety Shut-Off"],"specifications":{"Heat Technology":"Ionic Ceramic PTC","Voltage":"220V - 240V (Pakistani standard plug compatible)","Cord Length":"1.8 meter tangle-free swivel cord"},"isFeatured":true,"stockStatus":"in_stock","sku":"AMX-BTY-002","tag":"Popular"},"relatedProducts":[{"id":"prod-10","slug":"sonic-glow-silicone-facial-cleansing-brush","name":"SonicGlow Ultrasonic Waterproof Silicone Facial Cleansing Device","c