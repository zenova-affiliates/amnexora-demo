-1540932239986-30128078f3c5?auto=format&fit=crop&w=600&q=80","shortDescription":"Magnetic stick-on rechargeable motion sensor lights for staircases, wardrobes, kitchen counters, and hallways.","description":"Instantly light up dark corridors, closets, and kitchen shelves without any complicated wiring. Magnetic mounting allows you to easily detach them for quick USB recharging.","features":["120° Wide-Angle Infrared Motion Sensor (3-5 meter range)","Dual Modes: Always On or Smart Auto Night Sensing","Magnetic Base with 3M Adhesive Strips included","Warm 3000K Gentle Eye-Care Illumination"],"specifications":{"Pack Quantity":"3 units per pack","Recharge Method":"Micro-USB with built-in battery","Sensor Delay":"Turns off 20 seconds after motion ceases"},"stockStatus":"in_stock","sku":"AMX-HOM-003"}]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","product","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","product","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/a3f75afdd29d3f84.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://fonts.googleapis.com"}],["$","link",null,{"rel":"preconnect","href":"https://fonts.gstatic.com","crossOrigin":"anonymous"}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500